#include <windows.h>
#include "resource.h"

IDD_STATGHOST_PANEL DIALOGEX 0, 0, 220, 420
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CLIPCHILDREN | WS_VSCROLL
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "STATghost"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
END

IDD_STATGHOST_CONFIG DIALOGEX 0, 0, 360, 420
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "STATghost — Config"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    LTEXT           "STATghost executable (optional — sibling clone used when empty):", IDC_STATIC, 8, 8, 344, 8
    EDITTEXT        IDC_HOST_EXE, 8, 20, 280, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse…", IDC_HOST_BROWSE, 294, 19, 58, 14
    LTEXT           "Visible chrome actions (Ctrl+click to toggle):", IDC_STATIC, 8, 42, 344, 8
    LISTBOX         IDC_CHROME_LIST, 8, 54, 344, 320, LBS_MULTIPLESEL | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 210, 384, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 268, 384, 50, 14
END
