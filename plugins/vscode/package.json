  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js",
    "test:unit": "node --test out/test/chromeContract.test.js out/test/gridMetrics.test.js out/test/iconsFg.test.js out/test/protocol.test.js out/test/statement.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.0",
    "typescript": "^5.5.0"
  }
}
