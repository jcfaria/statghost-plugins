          "when": "true"
        }
      ],
      "editor/title": [
        {
          "submenu": "statghost.menu.send",
          "group": "navigation@90"
        },
        {
          "submenu": "statghost.menu.source",
          "group": "navigation@91"
        },
        {
          "submenu": "statghost.menu.inspect",
          "group": "navigation@92"
        },
        {
          "submenu": "statghost.menu.clear",
          "group": "navigation@93"
        },
        {
          "command": "statghost.cfg",
          "group": "navigation@94"
        },
        {
          "command": "statghost.arm",
          "group": "navigation@95"
        },
        {
          "command": "statghost.host",
          "group": "navigation@96"
        }
      ],
      "statghost.menu.send": [
        {
          "command": "statghost.send"
        },
        {
